{
  "kind": "collectionType",
  "collectionName": "service_categories",
  "info": {
    "singularName": "service-category",
    "pluralName": "service-categories",
    "displayName": "Service Category",
    "description": "Les 8 grandes catégories de services SYNCXELL"
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {
    "i18n": {
      "localized": true
    }
  },
  "attributes": {
    "name": {
      "type": "string",
      "required": true,
      "pluginOptions": { "i18n": { "localized": true } }
    },
    "slug": {
      "type": "uid",
      "targetField": "name",
      "required": true
    },
    "short_description": {
      "type": "text",
      "required": true,
      "pluginOptions": { "i18n": { "localized": true } }
    },
    "full_description": {
      "type": "richtext",
      "pluginOptions": { "i18n": { "localized": true } }
    },
    "icon_name": {
      "type": "string"
    },
    "icon_svg": {
      "type": "media",
      "multiple": false,
      "required": false,
      "allowedTypes": ["images"]
    },
    "cover_image": {
      "type": "media",
      "multiple": false,
      "required": false,
      "allowedTypes": ["images"]
    },
    "display_order": {
      "type": "integer",
      "required": true,
      "default": 99
    },
    "is_featured": {
      "type": "boolean",
      "default": false
    },
    "meta_title": {
      "type": "string",
      "pluginOptions": { "i18n": { "localized": true } }
    },
    "meta_description": {
      "type": "text",
      "pluginOptions": { "i18n": { "localized": true } }
    },
    "sub_services": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::sub-service.sub-service",
      "mappedBy": "category"
    }
  }
}
