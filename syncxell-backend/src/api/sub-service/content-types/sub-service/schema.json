{
  "kind": "collectionType",
  "collectionName": "sub_services",
  "info": {
    "singularName": "sub-service",
    "pluralName": "sub-services",
    "displayName": "Sub-Service",
    "description": "Les 17 sous-services détaillés (2-3 par catégorie)"
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {
    "i18n": {
      "localized": true
    }
  },
  "attributes": {
    "name": {
      "type": "string",
      "required": true,
      "pluginOptions": { "i18n": { "localized": true } }
    },
    "slug": {
      "type": "uid",
      "targetField": "name",
      "required": true
    },
    "tagline": {
      "type": "string",
      "pluginOptions": { "i18n": { "localized": true } }
    },
    "description": {
      "type": "richtext",
      "required": true,
      "pluginOptions": { "i18n": { "localized": true } }
    },
    "key_features": {
      "type": "json",
      "pluginOptions": { "i18n": { "localized": true } }
    },
    "technologies": {
      "type": "json"
    },
    "target_sectors": {
      "type": "json"
    },
    "cover_image": {
      "type": "media",
      "multiple": false,
      "required": false,
      "allowedTypes": ["images"]
    },
    "display_order": {
      "type": "integer",
      "required": true,
      "default": 99
    },
    "is_featured": {
      "type": "boolean",
      "default": false
    },
    "category": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::service-category.service-category",
      "inversedBy": "sub_services"
    },
    "case_studies": {
      "type": "relation",
      "relation": "manyToMany",
      "target": "api::case-study.case-study",
      "mappedBy": "related_services"
    },
    "meta_title": {
      "type": "string",
      "pluginOptions": { "i18n": { "localized": true } }
    },
    "meta_description": {
      "type": "text",
      "pluginOptions": { "i18n": { "localized": true } }
    }
  }
}
