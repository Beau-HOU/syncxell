{
  "kind": "collectionType",
  "collectionName": "team_members",
  "info": {
    "singularName": "team-member",
    "pluralName": "team-members",
    "displayName": "Team Member",
    "description": "Membres de l'équipe SYNCXELL"
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {
    "i18n": {
      "localized": true
    }
  },
  "attributes": {
    "full_name": {
      "type": "string",
      "required": true
    },
    "slug": {
      "type": "uid",
      "targetField": "full_name",
      "required": true
    },
    "job_title": {
      "type": "string",
      "required": true,
      "pluginOptions": { "i18n": { "localized": true } }
    },
    "bio": {
      "type": "richtext",
      "required": true,
      "pluginOptions": { "i18n": { "localized": true } }
    },
    "photo": {
      "type": "media",
      "multiple": false,
      "required": false,
      "allowedTypes": ["images"]
    },
    "linkedin_url": {
      "type": "string"
    },
    "clearance_level": {
      "type": "enumeration",
      "enum": ["public_trust", "secret", "top_secret", "unclassified"]
    },
    "specializations": {
      "type": "json",
      "pluginOptions": { "i18n": { "localized": true } }
    },
    "certifications_held": {
      "type": "relation",
      "relation": "manyToMany",
      "target": "api::certification.certification"
    },
    "is_leadership": {
      "type": "boolean",
      "default": false
    },
    "display_order": {
      "type": "integer",
      "default": 99
    }
  }
}
